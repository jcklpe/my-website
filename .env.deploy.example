# Static deploy configuration example.
# Copy this to .env.deploy or export the variables in your shell.
# Never commit .env.deploy or real provider credentials.

# Shared deploy settings.
STATIC_DEPLOY_PROVIDER=bunny
STATIC_DEPLOY_ENV=preview
STATIC_OUTPUT_DIR=apps/frontend/.output/public
STATIC_PUBLIC_SITE_URL=https://example.com
# Use http://dev.cms.my-website.localhost when deploying output generated
# from the dev/QA CMS.
STATIC_MEDIA_SOURCE_BASE_URL=http://cms.my-website.localhost
STATIC_MEDIA_LOCAL_ROOT=apps/cms/wp-content/uploads
# Optional. If blank, Bunny deploy scripts derive this from BUNNY_PULL_ZONE_URL
# and STATIC_MEDIA_STORAGE_PREFIX.
STATIC_MEDIA_BASE_URL=
STATIC_MEDIA_STORAGE_PREFIX=media
STATIC_DEPLOY_DRY_RUN=1

# Bunny.net candidate settings.
# Treat the storage access key like a password.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Optional path inside the storage zone, such as preview or production.
BUNNY_STATIC_PATH_PREFIX=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_PULL_ZONE_URL=
# Account-level API key from bunny.net dashboard (Settings > API). Required for
# cache purge. Different from BUNNY_STORAGE_ACCESS_KEY.
BUNNY_PURGE_API_KEY=
# Pull zone numeric ID, shown in the Bunny dashboard pull zone URL or CDN
# response headers (cdn-pullzone). Required for cache purge.
BUNNY_PULL_ZONE_ID=

# Cloudflare candidate settings.
# Use a least-privilege token scoped to the Pages project/account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=
CLOUDFLARE_API_TOKEN=

# Future provider-specific values can be added here, but real secrets stay out of Git.
