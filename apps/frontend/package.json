{
  "name": "@my-website/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "static:routes": "node scripts/static-routes.mjs",
    "static:generate": "NUXT_STATIC_GENERATE=1 nuxt generate && node scripts/static-finalize-output.mjs",
    "static:generate:public": "NUXT_STATIC_GENERATE=1 NUXT_STATIC_CMS_ENV=public nuxt generate && node scripts/static-finalize-output.mjs",
    "static:generate:qa": "NUXT_STATIC_GENERATE=1 NUXT_STATIC_CMS_ENV=qa nuxt generate && node scripts/static-finalize-output.mjs",
    "static:generate:content": "NUXT_STATIC_GENERATE=1 NUXT_STATIC_CMS_ENV=content nuxt generate && node scripts/static-finalize-output.mjs",
    "static:generate:dev": "NUXT_STATIC_GENERATE=1 NUXT_STATIC_CMS_ENV=dev nuxt generate && node scripts/static-finalize-output.mjs",
    "static:preview": "node scripts/static-preview.mjs",
    "static:deploy:plan": "node scripts/static-deploy-plan.mjs",
    "static:deploy:bunny": "node scripts/static-deploy-bunny.mjs",
    "static:release:list": "node scripts/static-release-list.mjs",
    "static:rollback:bunny": "node scripts/static-rollback-bunny.mjs",
    "static:prune:bunny": "node scripts/static-prune-bunny.mjs",
    "static:configure:bunny": "node scripts/static-configure-bunny.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "masonry-layout": "^4.2.2",
    "nuxt": "^3.19.0",
    "photoswipe": "^5.4.4",
    "shiki": "^4.0.2",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.4.1",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^24.3.0",
    "eslint": "^9.31.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.12"
  }
}
